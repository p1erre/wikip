# LLM API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_gemini_api_key_here

# LLM Configuration
LLM_PROVIDER=openai  # Options: openai, anthropic, google
OPENAI_MODEL=gpt-4-turbo-preview
ANTHROPIC_MODEL=claude-3-opus-20240229
GOOGLE_MODEL=gemini-1.5-flash  # Options: gemini-1.5-flash, gemini-1.5-pro

# Vision Model for Slide Analysis
VISION_MODEL_PROVIDER=google  # Options: openai, google
VISION_MODEL=gemini-1.5-flash  # gemini-1.5-flash (cheapest), gemini-1.5-pro, gpt-4o

# Paths
DOWNLOADS_DIR=./downloads
OUTPUT_DIR=./output
CACHE_DIR=./cache

# Logging
LOG_LEVEL=INFO
