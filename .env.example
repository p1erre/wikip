# LLM API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# LLM Configuration
LLM_PROVIDER=openai  # Options: openai, anthropic, google
OPENAI_MODEL=gpt-4-turbo-preview
ANTHROPIC_MODEL=claude-3-opus-20240229
GOOGLE_MODEL=gemini-1.5-flash  # Options: gemini-1.5-flash, gemini-1.5-pro

# Vision Model for Slide Analysis
VISION_MODEL_PROVIDER=openrouter  # Options: openai, google, openrouter
VISION_MODEL=google/gemini-flash-1.5  # OpenRouter: google/gemini-flash-1.5, google/gemini-pro-1.5, openai/gpt-4o

# Paths
DOWNLOADS_DIR=./downloads
OUTPUT_DIR=./output
CACHE_DIR=./cache

# Logging
LOG_LEVEL=INFO
