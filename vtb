#!/usr/bin/env python3
"""
Convenience wrapper for video-to-book CLI.

This script provides a simple entry point:
  ./vtb tools extract-id <url>
  ./vtb agent analyze <url>
  ./vtb chat  (future: interactive mode)

For development, you can also use:
  python -m src.cli.runner
  python -m src.cli.interactive
"""

import sys
from pathlib import Path

# Add src to path
sys.path.insert(0, str(Path(__file__).parent))

# Determine which CLI to run
if len(sys.argv) > 1 and sys.argv[1] == "chat":
    # Future: Interactive CLI
    from src.cli.interactive import main
else:
    # Current: Runner CLI
    from src.cli.runner import main

if __name__ == "__main__":
    sys.exit(main())
